{
    "author": "Sebastian Pekarek <mail@sebbo.net>",
    "bugs": {
        "url": "https://github.com/sebbo2002/action-template-updater/issues"
    },
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/github": "^9.1.1",
        "@octokit/rest": "^22.0.1",
        "simple-git": "^4.0.2"
    },
    "description": "Updates a fork of a template repository by creating pull requests for changes",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^11.0.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.2.0",
        "@vercel/ncc": "^0.45.0",
        "c8": "^12.0.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^3.4.1",
        "eslint-plugin-perfectionist": "^5.11.0",
        "esm": "^3.2.25",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "license-checker": "^25.0.1",
        "mocha": "^12.0.2",
        "mochawesome": "^8.1.1",
        "prettier": "^3.9.9",
        "semantic-release-license": "^1.0.3",
        "source-map-support": "^0.5.21",
        "tsdown": "^0.23.0",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0"
    },
    "engines": {
        "node": "22 || >=24.0.0"
    },
    "files": [
        "/dist"
    ],
    "homepage": "https://github.com/sebbo2002/action-template-updater#readme",
    "license": "MIT",
    "name": "@sebbo2002/action-template-updater",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sebbo2002/action-template-updater.git"
    },
    "scripts": {
        "build": "rm -rf ./dist && ncc build ./src/index.ts --license licenses.txt",
        "build-all": "./.github/workflows/build.sh",
        "coverage": "c8 mocha",
        "license-check": "license-checker --production --summary",
        "lint": "npx eslint . --fix && npx prettier . --write",
        "test": "mocha",
        "updater": "ts-node --esm ./src/bin/updater.ts"
    },
    "type": "module",
    "version": "1.0.0"
}
